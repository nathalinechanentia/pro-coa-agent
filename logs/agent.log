ory\n            WHEN "Significant (p<0.001)" THEN 1\n            WHEN "Significant (p<0.05)" THEN 2\n            WHEN "Trend" THEN 3\n            ELSE 4\n          END,\n          CASE t.pro_endpoint_position\n            WHEN "Primary" THEN 1\n            WHEN "Secondary" THEN 2\n            WHEN "Exploratory" THEN 3\n            ELSE 4\n          END\n        LIMIT 100\n        '
